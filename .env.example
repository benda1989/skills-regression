# ── LLM 配置（必填）────────────────────────────────────────────────────────
# OpenAI 兼容 API 密钥
OPENAI_API_KEY=your-api-key-here

# API 基础 URL（可选，默认使用 OpenAI；使用 DeepSeek/通义千问时需修改）
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（默认 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=deepseek-chat
# OPENAI_MODEL=qwen-turbo

# 模型参数（可选）
OPENAI_TEMPERATURE=0.1
# OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=60.0
OPENAI_MAX_RETRIES=3

# ── API 安全（必填，生产环境）─────────────────────────────────────────────
# Bearer token 密钥，留空则跳过鉴权（仅开发环境）
API_SECRET_KEY=your-secret-key-here

# ── 服务配置（可选）───────────────────────────────────────────────────────
# 运行环境：development / production（生产环境自动关闭 /docs）
ENV=development

# CORS 允许的源，英文逗号分隔（留空则允许本地开发端口）
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://app.example.com
